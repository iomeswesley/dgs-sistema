// Schema do Sistema DGS — ver PLANO.md para o desenho completo.
//
// Princípio central: contagens derivadas (planejados, confirmados, recusados,
// sem resposta) NUNCA são colunas — sempre calculadas a partir de Appointment.
// Só os checks 2 (atendidos) e 3 (pagos) são lançamentos manuais, e por isso
// carregam quem lançou e quando, além de entrada no AuditLog.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
 * ----------------------------------------------------------------------
 */
/**
 * Clientes (multi-cliente)
 */
/**
 * ----------------------------------------------------------------------
 */

// Convenção de isolamento: toda tabela do domínio tem uma coluna `clientId`
// com índice, e o filtro é injetado automaticamente por requisição (ver
// PLANO-MULTICLIENTE.md, seção 4). Tabelas de infraestrutura ficam de fora
// de propósito: `users` (pessoa da DGS, uma conta só, acesso concedido via
// UserClient), `password_resets`, `rate_limit_hits` e a tabela `session`
// criada em runtime pelo connect-pg-simple.
//
// ATENÇÃO — `Client` NÃO é a mesma coisa que `Municipality`: um cliente está
// um nível ACIMA. A DGS é um cliente que atende vários municípios (Camboriú,
// Blumenau, Pomerode, Indaial); uma prefeitura que contrate direto será outro
// cliente, com um município só. Confundir os dois quebra o dado que já está
// em produção.
model Client {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               UserClient[]
  municipalities      Municipality[]
  healthUnits         HealthUnit[]
  doctors             Doctor[]
  procedures          Procedure[]
  doctorProcedures    DoctorProcedure[]
  agendas             Agenda[]
  lists               List[]
  patients            Patient[]
  appointments        Appointment[]
  cancellationBatches CancellationBatch[]
  messageJobs         MessageJob[]
  whatsappMessages    WhatsappMessage[]
  whatsappAccounts    WhatsappAccount[]
  closings            DailyClosing[]
  closingAttachments  ClosingAttachment[]
  auditLogs           AuditLog[]
  settings            AppSettings?

  @@map("clients")
}

// Quais clientes cada pessoa da equipe pode acessar. Uma pessoa tem UM login
// e pode atender vários clientes (diferente dos projetos irmãos, onde cada
// usuário pertence a um tenant só) — reflete como a equipe da DGS já
// trabalha hoje: a mesma pessoa cuida de várias prefeituras.
model UserClient {
  id        Int      @id @default(autoincrement())
  userId    Int
  clientId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
  @@map("user_clients")
}

/**
 * ----------------------------------------------------------------------
 */
/**
 * Equipe
 */
/**
 * ----------------------------------------------------------------------
 */

// Dentro de um cliente o perfil continua único: todo mundo da equipe tem os
// mesmos poderes, e o controle vem do AuditLog (quem lançou o quê), não de
// permissões — decisão original, ver PLANO.md.
//
// A única distinção de papel é `isSuperAdmin`: administrador da plataforma
// (a DGS), que enxerga todos os clientes. Diferente dos projetos irmãos, que
// usam uma credencial fixa em variável de ambiente — aqui todo mundo que loga
// já é da própria DGS, então vale mais manter o mesmo login e a mesma
// auditoria de todo mundo (ver PLANO-MULTICLIENTE.md, seção 2).
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  isSuperAdmin Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clients                   UserClient[]
  passwordResets            PasswordReset[]
  auditLogs                 AuditLog[]
  uploadedLists             List[]              @relation("ListUploadedBy")
  approvedLists             List[]              @relation("ListApprovedBy")
  manualContacts            Appointment[]       @relation("AppointmentContactedBy")
  canceledAppointments      Appointment[]       @relation("AppointmentCanceledBy")
  cancellationBatches       CancellationBatch[]
  attendedClosings          DailyClosing[]      @relation("ClosingAttendedBy")
  paidClosings              DailyClosing[]      @relation("ClosingPaidBy")
  connectedWhatsappAccounts WhatsappAccount[]

  @@map("users")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/**
 * ----------------------------------------------------------------------
 */
/**
 * Cadastros
 */
/**
 * ----------------------------------------------------------------------
 */

model Municipality {
  id        Int      @id @default(autoincrement())
  clientId  Int
  name      String
  state     String   @default("SC")
  // Observações sobre o formato da lista que essa prefeitura manda
  // (ex: "SISREG, cabeçalho com procedimento único").
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       Client         @relation(fields: [clientId], references: [id])
  units        HealthUnit[]
  agendas      Agenda[]
  lists        List[]
  appointments Appointment[]
  closings     DailyClosing[]

  // Unicidade por cliente, não global: dois clientes podem legitimamente
  // atender o mesmo município.
  @@unique([clientId, name, state])
  @@index([clientId])
  @@map("municipalities")
}

// Unidade de saúde. A mesma unidade pode ser executante (onde o atendimento
// acontece) e solicitante (a UBS que encaminhou) — por isso não há tipo, o
// papel vem de qual campo referencia a unidade.
model HealthUnit {
  id             Int      @id @default(autoincrement())
  clientId       Int
  municipalityId Int
  name           String
  address        String?
  phone          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client                Client        @relation(fields: [clientId], references: [id])
  municipality          Municipality  @relation(fields: [municipalityId], references: [id])
  agendas               Agenda[]
  requestedAppointments Appointment[] @relation("AppointmentRequestingUnit")

  // Já fica isolado transitivamente (o município é de um cliente só), mas o
  // clientId próprio permite filtrar sem join e é a convenção do schema.
  @@unique([municipalityId, name])
  @@index([municipalityId])
  @@index([clientId])
  @@map("health_units")
}

model Doctor {
  id           Int      @id @default(autoincrement())
  clientId     Int
  name         String
  specialty    String?
  registration String? // CRM
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client       Client            @relation(fields: [clientId], references: [id])
  procedures   DoctorProcedure[]
  agendas      Agenda[]
  appointments Appointment[]
  closings     DailyClosing[]

  @@index([clientId])
  @@map("doctors")
}

model Procedure {
  id                      Int      @id @default(autoincrement())
  clientId                Int
  name                    String
  // Preparo enviado no lembrete de véspera (jejum, bexiga cheia, etc.).
  // Quando vazio, o template usa um texto neutro — a Meta não aceita
  // variável em branco.
  preparationInstructions String?
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  client       Client            @relation(fields: [clientId], references: [id])
  doctors      DoctorProcedure[]
  agendas      Agenda[]
  appointments Appointment[]
  closings     DailyClosing[]

  // Unicidade por cliente, nao global: dois clientes podem ter "ULTRASSOM".
  @@unique([clientId, name])
  @@index([clientId])
  @@map("procedures")
}

// Configuração por médico × procedimento: capacidade e valores. É daqui que
// saem o "esperado por dia" da sugestão de confirmações e o financeiro
// (repasse ao médico e faturamento da prefeitura).
model DoctorProcedure {
  id              Int      @id @default(autoincrement())
  clientId        Int
  doctorId        Int
  procedureId     Int
  minutesPerVisit Int?
  expectedPerDay  Int?
  // Valor pago ao médico por procedimento realizado.
  doctorFee       Decimal? @db.Decimal(10, 2)
  // Valor cobrado da prefeitura por procedimento realizado.
  cityRate        Decimal? @db.Decimal(10, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client    Client    @relation(fields: [clientId], references: [id])
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([doctorId, procedureId])
  @@index([doctorId])
  @@index([clientId])
  @@map("doctor_procedures")
}

/**
 * ----------------------------------------------------------------------
 */
/**
 * Agenda e listas
 */
/**
 * ----------------------------------------------------------------------
 */

// Escala do médico: o sistema sabe o esperado ANTES da lista chegar. Uma
// agenda pode receber a lista original e listas complementares (reposição
// de vagas), daí a relação 1:N com List.
model Agenda {
  id             Int      @id @default(autoincrement())
  clientId       Int
  doctorId       Int
  municipalityId Int
  unitId         Int?
  procedureId    Int?
  date           DateTime @db.Date
  shift          Shift    @default(INTEGRAL)
  capacity       Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client              Client              @relation(fields: [clientId], references: [id])
  doctor              Doctor              @relation(fields: [doctorId], references: [id])
  municipality        Municipality        @relation(fields: [municipalityId], references: [id])
  unit                HealthUnit?         @relation(fields: [unitId], references: [id])
  procedure           Procedure?          @relation(fields: [procedureId], references: [id])
  lists               List[]
  appointments        Appointment[]
  cancellationBatches CancellationBatch[]

  @@index([date])
  @@index([doctorId, date])
  @@index([clientId])
  @@map("agendas")
}

// Cada arquivo (PDF ou foto) recebido de uma prefeitura.
model List {
  id              Int          @id @default(autoincrement())
  clientId        Int
  municipalityId  Int
  agendaId        Int?
  originalName    String
  fileData        Bytes
  mimeType        String
  sizeBytes       Int?
  sourceFormat    SourceFormat @default(OUTRO)
  status          ListStatus   @default(EXTRAINDO)
  // Lista complementar enviada pra preencher vagas abertas de uma agenda que
  // já teve disparo (fase 2).
  isComplementary Boolean      @default(false)
  // Resposta bruta da extração da IA, guardada pra auditoria e pra
  // reprocessar sem precisar reler o arquivo.
  extractionRaw   Json?
  extractionError String?
  extractedAt     DateTime?
  uploadedById    Int
  approvedById    Int?
  approvedAt      DateTime?
  dispatchedAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  client              Client              @relation(fields: [clientId], references: [id])
  municipality        Municipality        @relation(fields: [municipalityId], references: [id])
  agenda              Agenda?             @relation(fields: [agendaId], references: [id])
  uploadedBy          User                @relation("ListUploadedBy", fields: [uploadedById], references: [id])
  approvedBy          User?               @relation("ListApprovedBy", fields: [approvedById], references: [id])
  appointments        Appointment[]
  cancellationBatches CancellationBatch[]

  @@index([municipalityId])
  @@index([status])
  @@index([clientId])
  @@map("lists")
}

/**
 * ----------------------------------------------------------------------
 */
/**
 * Pacientes e agendamentos
 */
/**
 * ----------------------------------------------------------------------
 */

// Entidade própria (não só linha de lista) pra ter histórico entre listas,
// score de no-show e opt-out de LGPD. Dedupe por CNS quando existir, senão
// por telefone normalizado.
model Patient {
  id         Int       @id @default(autoincrement())
  clientId   Int
  name       String
  cns        String?
  birthDate  DateTime? @db.Date
  // Todos os telefones conhecidos, em E.164. As listas trazem até 5 colunas
  // de telefone por paciente — guardar todos permite fallback quando o
  // primeiro número falha.
  phones     String[]  @default([])
  // Paciente pediu pra não receber mensagens. Obrigatório respeitar (LGPD),
  // e é a defesa mais barata contra denúncia de spam no WhatsApp.
  optedOut   Boolean   @default(false)
  optedOutAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client       Client        @relation(fields: [clientId], references: [id])
  appointments Appointment[]

  // Unicidade por cliente, nao global: a mesma pessoa pode ser atendida por
  // dois clientes (municipios vizinhos) - com CNS global, o segundo cadastro
  // falharia na insercao e derrubaria a lista inteira.
  @@unique([clientId, cns])
  @@index([name])
  @@index([clientId])
  @@map("patients")
}

model Appointment {
  id                   Int               @id @default(autoincrement())
  clientId             Int
  listId               Int
  agendaId             Int?
  patientId            Int
  municipalityId       Int
  doctorId             Int
  procedureId          Int
  requestingUnitId     Int?
  scheduledAt          DateTime
  isFirstVisit         Boolean?
  // Snapshot dos telefones como vieram na lista (E.164), independente do
  // cadastro do paciente — a lista da prefeitura pode trazer um número novo.
  phones               String[]          @default([])
  // Número escolhido para o disparo (o melhor candidato a WhatsApp).
  selectedPhone        String?
  status               AppointmentStatus @default(PENDENTE)
  refusalReason        RefusalReason?
  refusalNote          String?
  respondedAt          DateTime?
  // Contato manual (equipe ligou) — sem isso esses casos voltariam pro papel.
  contactedById        Int?
  contactedAt          DateTime?
  contactNote          String?
  // Cancelamento pela DGS (médico indisponível) — motivo é texto livre
  // (não um enum como RefusalReason: quem cancela é a equipe, escrevendo o
  // motivo na hora, não escolhendo de uma lista fixa).
  cancellationBatchId  Int?
  canceledById         Int?
  canceledAt           DateTime?
  // 0..1 — abaixo do limiar a linha aparece destacada na revisão.
  extractionConfidence Float?
  manuallyEdited       Boolean           @default(false)
  // Linha bruta como a IA extraiu, pra conferir contra o arquivo original.
  rawLine              Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  client            Client             @relation(fields: [clientId], references: [id])
  list              List               @relation(fields: [listId], references: [id], onDelete: Cascade)
  agenda            Agenda?            @relation(fields: [agendaId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id])
  municipality      Municipality       @relation(fields: [municipalityId], references: [id])
  doctor            Doctor             @relation(fields: [doctorId], references: [id])
  procedure         Procedure          @relation(fields: [procedureId], references: [id])
  requestingUnit    HealthUnit?        @relation("AppointmentRequestingUnit", fields: [requestingUnitId], references: [id])
  contactedBy       User?              @relation("AppointmentContactedBy", fields: [contactedById], references: [id])
  canceledBy        User?              @relation("AppointmentCanceledBy", fields: [canceledById], references: [id])
  cancellationBatch CancellationBatch? @relation(fields: [cancellationBatchId], references: [id])

  messages    WhatsappMessage[]
  messageJobs MessageJob[]

  @@index([listId])
  @@index([patientId])
  @@index([status])
  @@index([scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([cancellationBatchId])
  @@index([clientId])
  @@map("appointments")
}

// Um "disparo" de cancelamento — agrupa os agendamentos cancelados juntos
// (mesma agenda, mesmo motivo, mesma hora), pra dar a tela de histórico
// ("mostrar todas as mensagens de cancelamento enviadas") sem precisar
// recalcular agrupamento por data/hora toda vez.
// Origem do cancelamento: uma Agenda já cadastrada (caminho normal) OU uma
// List enviada na hora, sem agenda nenhuma (caminho "nunca passou pela
// plataforma" — 2026-08-25). Exatamente um dos dois é preenchido, nunca os
// dois nem nenhum — validado na camada de aplicação, não no banco.
model CancellationBatch {
  id          Int      @id @default(autoincrement())
  clientId    Int
  agendaId    Int?
  listId      Int?
  reason      String
  createdById Int
  createdAt   DateTime @default(now())

  client       Client        @relation(fields: [clientId], references: [id])
  agenda       Agenda?       @relation(fields: [agendaId], references: [id])
  list         List?         @relation(fields: [listId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  appointments Appointment[]

  @@index([agendaId])
  @@index([listId])
  @@index([clientId])
  @@map("cancellation_batches")
}

/**
 * ----------------------------------------------------------------------
 */
/**
 * WhatsApp
 */
/**
 * ----------------------------------------------------------------------
 */

// Fila de envio. Disparo em massa é assíncrono por causa do limite diário da
// Meta: o processador respeita o teto do dia e reporta o que não coube, em
// vez de falhar em silêncio.
model MessageJob {
  id            Int          @id @default(autoincrement())
  clientId      Int
  appointmentId Int
  template      TemplateKind
  phone         String
  scheduledFor  DateTime     @default(now())
  status        JobStatus    @default(PENDENTE)
  attempts      Int          @default(0)
  lastError     String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  client      Client      @relation(fields: [clientId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // A fila passa a ser por cliente (teto diario e do numero na Meta, que e
  // por cliente) - este indice e o que a reserva atomica de jobs usa.
  @@index([clientId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@index([appointmentId])
  @@map("message_jobs")
}

// Linha única (id sempre 1) com configurações do sistema que a equipe pode
// ajustar em Configurações, sem precisar de deploy — hoje só a retenção da
// mídia recebida do paciente (ver WhatsappMessage.mediaData).
model AppSettings {
  id                 Int      @id @default(autoincrement())
  // Uma linha por cliente (antes era linha unica com id fixo 1).
  clientId           Int      @unique
  mediaRetentionDays Int      @default(7)
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("app_settings")
}

model WhatsappMessage {
  id            Int            @id @default(autoincrement())
  clientId      Int
  appointmentId Int?
  // Id da mensagem na Meta. Único: garante idempotência quando o webhook
  // reentrega o mesmo evento.
  wamid         String?        @unique
  direction     Direction
  template      TemplateKind?
  phone         String
  body          String?
  // Payload do clique do botão, quando a resposta veio por quick reply.
  buttonPayload String?
  // Mídia recebida do paciente (imagem, áudio, figurinha, documento) — baixada
  // da Meta e guardada aqui só enquanto durar a retenção configurável
  // (AppSettings.mediaRetentionDays, ver purgeExpiredMedia). `null` quando a
  // mensagem não tem mídia, quando o download falhou (best-effort, não trava
  // o registro da mensagem) ou depois de expurgada.
  mediaData     Bytes?
  mediaMimeType String?
  mediaFilename String?
  status        DeliveryStatus @default(ENVIADO)
  errorCode     String?
  errorMessage  String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  raw           Json?
  createdAt     DateTime       @default(now())

  client      Client       @relation(fields: [clientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([phone])
  @@index([clientId, phone])
  @@map("whatsapp_messages")
}

// Conta do WhatsApp Business conectada via Embedded Signup (fluxo de
// Provedor de Tecnologia da Meta). Um único cliente (a própria DGS) usa o
// sistema, então basta uma linha — o serviço mantém no máximo uma ativa em
// vez de multi-tenant de verdade. Token vive só aqui, nunca em log/auditoria.
// Suporta mais de uma linha de propósito (failover manual — ver CLAUDE.md):
// a equipe pode conectar um segundo número de reserva e trocar qual está
// ativo pela tela, sem precisar mexer em .env, se o número em uso for
// bloqueado. `active` decide qual credencial o sistema usa pra enviar —
// só uma linha por vez tem `active: true` (garantido pela aplicação, não
// por constraint de banco).
model WhatsappAccount {
  id             Int       @id @default(autoincrement())
  clientId       Int
  wabaId         String
  // Id do numero na Meta. Unico no sistema inteiro (e o que o webhook usa
  // pra descobrir de qual cliente e a mensagem que chegou - sem isso, uma
  // resposta poderia ser atribuida ao cliente errado).
  phoneNumberId  String    @unique
  businessName   String?
  // Apelido interno da equipe (ex.: "Principal", "Reserva — colega"),
  // separado do businessName que vem da Meta — esse a equipe não controla
  // (é o que aparece pro paciente), o label é só pra organizar a tela.
  label          String?
  accessToken    String
  tokenExpiresAt DateTime?
  active         Boolean   @default(true)
  connectedById  Int?
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client      Client @relation(fields: [clientId], references: [id])
  connectedBy User?  @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("whatsapp_accounts")
}

/**
 * ----------------------------------------------------------------------
 */
/**
 * Conciliação e auditoria
 */
/**
 * ----------------------------------------------------------------------
 */

// Checks 2 e 3 da conciliação. Os confirmados (check 1) não estão aqui de
// propósito — são derivados de Appointment.status.
model DailyClosing {
  id             Int      @id @default(autoincrement())
  clientId       Int
  doctorId       Int
  municipalityId Int
  procedureId    Int?
  date           DateTime @db.Date

  // Check 2 — o que o médico informou ter atendido.
  attendedReported     Int?
  attendedReportedById Int?
  attendedReportedAt   DateTime?

  // Check 3 — o que o financeiro confirmou nas guias. É o que vira pagamento.
  paidCount     Int?
  paidCountById Int?
  paidCountAt   DateTime?

  // Atendidos que não estavam na lista. Sem isso, % de comparecimento
  // estoura 100% e a conciliação nunca fecha.
  extrasCount Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client             Client              @relation(fields: [clientId], references: [id])
  doctor             Doctor              @relation(fields: [doctorId], references: [id])
  municipality       Municipality        @relation(fields: [municipalityId], references: [id])
  procedure          Procedure?          @relation(fields: [procedureId], references: [id])
  attendedReportedBy User?               @relation("ClosingAttendedBy", fields: [attendedReportedById], references: [id])
  paidCountBy        User?               @relation("ClosingPaidBy", fields: [paidCountById], references: [id])
  attachments        ClosingAttachment[]

  // Sem @@unique aqui de propósito: procedureId é nulável e o Postgres trata
  // NULL como distinto de NULL, então um índice único comum deixaria
  // duplicar o fechamento "sem procedimento" do mesmo médico e dia — numa
  // tabela que vira pagamento. A garantia vem de dois índices parciais
  // criados na migration (um para procedureId NOT NULL, outro para NULL).
  @@index([doctorId, municipalityId, date])
  @@index([date])
  @@index([clientId])
  @@map("daily_closings")
}

// Guias anexadas como evidência do check 3.
model ClosingAttachment {
  id           Int      @id @default(autoincrement())
  clientId     Int
  closingId    Int
  originalName String
  fileData     Bytes
  mimeType     String
  uploadedById Int
  createdAt    DateTime @default(now())

  client  Client       @relation(fields: [clientId], references: [id])
  closing DailyClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)

  @@index([closingId])
  @@index([clientId])
  @@map("closing_attachments")
}

// Toda alteração de lançamento manual. É o que compensa a ausência de
// perfis separados — sem roles, a rastreabilidade tem que ser total.
model AuditLog {
  id        Int      @id @default(autoincrement())
  clientId  Int
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  field     String?
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([clientId])
  @@map("audit_logs")
}

// Rate limit persistido no banco, não em memória: em serverless cada
// instância teria seu próprio Map e o limite não valeria nada.
model RateLimitHit {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

