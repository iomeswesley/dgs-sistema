{
  "framework": null,
  "buildCommand": "npm run build",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist,dist-web,node_modules/pdfjs-dist,node_modules/pdfkit}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/queue",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/queue",
      "schedule": "0 19 * * *"
    }
  ],
  "outputDirectory": "dist-web",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
