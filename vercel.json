{
  "framework": null,
  "buildCommand": "npm run build",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist-web/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/queue",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 21 * * *"
    }
  ]
}
