# Copie para .env e preencha. Nunca versione o .env nem cole chaves no chat.

NODE_ENV=development
PORT=3000

# Em dev, sobe com `docker compose up -d` (ver docker-compose.yml na raiz) e
# aponte pro Postgres local:
#   DATABASE_URL="postgresql://postgres:dgs_local_dev@localhost:5432/sistema_dgs"
#   DIRECT_URL="postgresql://postgres:dgs_local_dev@localhost:5432/sistema_dgs"
# Em produção é o Supabase (projeto DEDICADO deste sistema — não reaproveitar
# o de outro projeto): DATABASE_URL é o pooler em modo transaction (porta
# 6543), DIRECT_URL é a conexão direta (porta 5432), usada pelo Prisma
# Migrate. Guarde esses valores reais em `.env.production`, nunca aqui.
DATABASE_URL=
DIRECT_URL=

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Criptografa segredos gravados no banco (hoje só o accessToken do WhatsApp
# conectado via Embedded Signup — ver src/lib/token-crypto.ts). Precisa
# decodificar (base64) pra exatamente 32 bytes. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Opcional em dev (sem ela, o token grava em texto puro, com aviso no
# console) — OBRIGATÓRIO estar configurada em produção.
TOKEN_ENCRYPTION_KEY=

# URL pública do sistema, sem barra no final.
PUBLIC_BASE_URL=

# Extração das listas (PDF/foto). Sem a chave, o upload aceita o arquivo mas
# não extrai nada.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta). Sem ACCESS_TOKEN + PHONE_NUMBER_ID, todo envio
# vira log no console — é assim que se desenvolve sem risco de mandar
# mensagem real para telefone de paciente.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# App ID (público) e Configuration ID do Embedded Signup, criados no App
# Dashboard da Meta (app "dgs-system" -> WhatsApp -> Configuração da API).
# Habilitam o botão "Conectar WhatsApp" em Configurações — sem eles, quem
# conectar a conta continua precisando preencher ACCESS_TOKEN/PHONE_NUMBER_ID
# à mão (fluxo antigo, ainda funciona como fallback de sandbox/dev).
WHATSAPP_APP_ID=
WHATSAPP_SIGNUP_CONFIG_ID=
# ID da conta do WhatsApp Business (WABA). Usado só pra criar/submeter os
# templates (scripts/criar-templates-whatsapp.ts) — o envio não precisa dele.
# O token usado aqui precisa da permissão whatsapp_business_management, que é
# diferente da whatsapp_business_messaging usada pra enviar.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Espelha o tier atual do número na Meta. A fila para ao bater esse teto e
# reporta o que não coube, em vez de queimar a qualidade do número.
WHATSAPP_DAILY_LIMIT=250

# E-mail transacional (recuperação de senha).
RESEND_API_KEY=
EMAIL_FROM=

# Monitoramento de erro.
SENTRY_DSN=

# Autentica as chamadas do Vercel Cron.
CRON_SECRET=
